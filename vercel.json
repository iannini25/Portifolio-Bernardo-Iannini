{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "cleanUrls": false,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; frame-src 'self' https://*.vercel.app; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://rnupfyzpwwvspiwnttsl.supabase.co https:; connect-src 'self' https://rnupfyzpwwvspiwnttsl.supabase.co wss://rnupfyzpwwvspiwnttsl.supabase.co"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|avif|gif|svg|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/bernardolindao.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/bernardolindao",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/img/athena7-cover.webp",
      "destination": "/img/covers/athena7.webp",
      "permanent": true
    },
    {
      "source": "/img/moedanobre-cover.webp",
      "destination": "/img/covers/moedanobre.webp",
      "permanent": true
    },
    {
      "source": "/img/iba-cover.webp",
      "destination": "/img/covers/iba.webp",
      "permanent": true
    },
    {
      "source": "/img/modulo-engenharia.webp",
      "destination": "/img/covers/modulo-engenharia.webp",
      "permanent": true
    },
    {
      "source": "/img/brasa-restaurante.webp",
      "destination": "/img/covers/brasa.webp",
      "permanent": true
    },
    {
      "source": "/img/sereno.webp",
      "destination": "/img/covers/sereno.webp",
      "permanent": true
    },
    {
      "source": "/img/amarofy.webp",
      "destination": "/img/covers/amarofy.webp",
      "permanent": true
    },
    {
      "source": "/img/automotiva-express.webp",
      "destination": "/img/covers/automotiva-express.webp",
      "permanent": true
    },
    {
      "source": "/img/portfolio-cover.webp",
      "destination": "/img/covers/portfolio.webp",
      "permanent": true
    },
    {
      "source": "/videos/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
